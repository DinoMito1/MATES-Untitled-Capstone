[sub_resource type="GDScript" id="GDScript_t0eqp"]
script/source = "extends CharacterBody3D


const SPEED = 12.0
const JUMP_VELOCITY = 12.5


func _physics_process(delta: float) -> void:
	# Add the gravity.
	if not is_on_floor():
		velocity += get_gravity() * delta
	#$\"../cameraPivot\".position = self.position

	# spin camear via mouse movement. might need to detect when mouse is moved in a direction and choose how far to move based on distance

	# Handle jump.
	if Input.is_action_just_pressed(\"jump\") and is_on_floor():
		velocity.y = JUMP_VELOCITY

	var input_dir := Input.get_vector(\"move_left\", \"move_right\", \"move_up\", \"move_down\")
	#var direction := (transform.basis * Vector3(input_dir.x, 0, input_dir.y)).normalized()
	var direction := (Vector3(input_dir.x, 0, input_dir.y)).normalized()
	if direction:
		velocity.x = direction.x * SPEED # move local to camera
		velocity.z = direction.z * SPEED
		#rotate character to face towards direction
	else:
		velocity.x = move_toward(velocity.x, 0, SPEED)
		velocity.z = move_toward(velocity.z, 0, SPEED)

	move_and_slide()
"

